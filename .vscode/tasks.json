{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "uvicorn", "backend.app.main:app", "--reload", "--reload-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Dev: frontend",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["--prefix", "frontend", "run", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Dev: all",
      "dependsOn": ["Dev: backend", "Dev: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
